openapi: 3.0.3
info:
  title: CAB - Booking Service API
  description: >
    API tạo và theo dõi Booking (yêu cầu đặt xe).
    Nguồn: FR-009 → FR-017, UC-04, AC-03.01 → AC-03.10.
  version: "1.0.0"
servers:
  - url: https://api.cab.example.com/v1

tags:
  - name: Booking

paths:
  /bookings:
    post:
      tags: [Booking]
      summary: Tạo yêu cầu đặt xe (Create Booking)
      description: >
        FR-009 → FR-017, UC-04, AC-03.01 → AC-03.02, AC-03.08, AC-03.09.
        Sau khi tạo thành công, Booking ở trạng thái SEARCHING_DRIVER và quá trình
        matching (xem Matching Service) sẽ được kích hoạt bất đồng bộ.
      operationId: createBooking
      security:
        - bearerAuth: []
      parameters:
        - name: Idempotency-Key
          in: header
          required: false
          description: Đảm bảo cùng một request không tạo duplicate Booking (AC-21.01)
          schema:
            type: string
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CreateBookingRequest'
      responses:
        '201':
          description: Booking được tạo thành công, trạng thái SEARCHING_DRIVER (AC-03.02)
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Booking'
        '400':
          description: Dữ liệu pickup/destination/vehicle type không hợp lệ (AC-03.09)
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
        '401':
          description: Customer chưa đăng nhập (AC-03.08)
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
        '422':
          description: Booking bị từ chối do không đáp ứng business rule đã cấu hình (FR-017)
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

  /customers/me/bookings:
    get:
      tags: [Booking]
      summary: Xem danh sách booking của Customer hiện tại
      description: FR-016
      operationId: listMyBookings
      security:
        - bearerAuth: []
      parameters:
        - name: status
          in: query
          required: false
          schema:
            $ref: '#/components/schemas/BookingStatus'
        - name: page
          in: query
          schema:
            type: integer
            default: 1
        - name: pageSize
          in: query
          schema:
            type: integer
            default: 20
      responses:
        '200':
          description: Danh sách booking
          content:
            application/json:
              schema:
                type: object
                properties:
                  items:
                    type: array
                    items:
                      $ref: '#/components/schemas/Booking'
                  page:
                    type: integer
                  pageSize:
                    type: integer
                  totalItems:
                    type: integer

  /bookings/{bookingId}:
    get:
      tags: [Booking]
      summary: Xem chi tiết / trạng thái hiện tại của Booking
      description: FR-016, UC-04
      operationId: getBookingById
      security:
        - bearerAuth: []
      parameters:
        - $ref: '#/components/parameters/BookingIdPath'
      responses:
        '200':
          description: Chi tiết booking
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Booking'
        '401':
          description: Chưa đăng nhập
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
        '403':
          description: Booking không thuộc về Customer đang truy vấn
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
        '404':
          description: Không tìm thấy booking
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

components:
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT

  parameters:
    BookingIdPath:
      name: bookingId
      in: path
      required: true
      schema:
        type: string
        format: uuid

  schemas:
    BookingStatus:
      type: string
      description: >
        SEARCHING_DRIVER → ASSIGNED → (chuyển thành Trip) | NO_DRIVER_FOUND
      enum: [SEARCHING_DRIVER, ASSIGNED, NO_DRIVER_FOUND, CANCELLED]

    CreateBookingRequest:
      type: object
      required: [pickupLocation, dropoffLocation, vehicleTypeId]
      properties:
        pickupLocation:
          $ref: '#/components/schemas/GeoLocation'
        dropoffLocation:
          $ref: '#/components/schemas/GeoLocation'
        vehicleTypeId:
          type: string
          format: uuid
          description: Loại xe/dịch vụ khách hàng chọn (FR-010)

    GeoLocation:
      type: object
      required: [latitude, longitude]
      properties:
        address:
          type: string
          example: "123 Nguyen Trai, Q1, HCMC"
        latitude:
          type: number
          format: double
        longitude:
          type: number
          format: double

    Booking:
      type: object
      properties:
        bookingId:
          type: string
          format: uuid
        customerId:
          type: string
          format: uuid
        pickupLocation:
          $ref: '#/components/schemas/GeoLocation'
        dropoffLocation:
          $ref: '#/components/schemas/GeoLocation'
        vehicleTypeId:
          type: string
          format: uuid
        status:
          $ref: '#/components/schemas/BookingStatus'
        tripId:
          type: string
          format: uuid
          nullable: true
          description: Được gán khi Booking matching thành công và chuyển thành Trip
        createdAt:
          type: string
          format: date-time

    Error:
      type: object
      properties:
        code:
          type: string
        message:
          type: string
        details:
          type: array
          items:
            type: string
